def cmd_run(args, base_url, token):
    # ad-hoc (--steps) を最優先で処理。path との併用はドキュメント上排他なのでエラーで弾く。
    if args.steps is not None:
        if args.path:
            raise SystemExit(_red("path と --steps は同時に指定できません (どちらか一方)"))
        body = _build_adhoc_body(args.steps)
        results = [_run_scenario(base_url, token, body, "(ad-hoc)")]
        _finalize_run(args, results, single=True)
        return

    if not args.path:
        raise SystemExit(_red("path か --steps を指定"))

    # path に glob メタ文字 (*, ?, [...]) が含まれていれば一覧取得 → フィルタ → 順次実行。
    if any(c in args.path for c in ("*", "?", "[")):
        targets = _expand_scenario_glob(base_url, token, args.path)
        if not targets:
            raise SystemExit(_red(f"glob '{args.path}' に一致するシナリオがありません"))
        results = [_run_scenario(base_url, token, {"path": p}, p) for p in targets]
        _finalize_run(args, results, single=False)
        return

    # 通常の単一シナリオ実行
    results = [_run_scenario(base_url, token, {"path": args.path}, args.path)]
    _finalize_run(args, results, single=True)


def _build_adhoc_body(steps_arg: str) -> dict:
    """--steps の値 ('-' なら stdin、それ以外はファイルパス) を request body にする。"""
    if steps_arg == "-":
        raw = sys.stdin.read()
    else:
        try:
            raw = Path(steps_arg).read_text(encoding="utf-8")
        except OSError as e:
            raise SystemExit(_red(f"--steps の読み込みに失敗: {e}"))
    try:
        steps_obj = json.loads(raw)
    except json.JSONDecodeError as e:
        raise SystemExit(_red(f"--steps の JSON パースに失敗: {e}"))
    # 配列直書きと {"steps":[...]} のどちらでも受ける。
    if isinstance(steps_obj, list):
        return {"steps": steps_obj}
    if isinstance(steps_obj, dict) and "steps" in steps_obj:
        return {"steps": steps_obj["steps"]}
    raise SystemExit(_red("--steps は配列 or {steps:[...]} を渡す"))


def _run_scenario(base_url: str, token: str | None, body: dict, label: str) -> tuple[str, dict]:
    """1 シナリオ実行して (label, response) を返す。"""
    status, resp = _request("POST", f"{base_url}/api/v1/scenarios/run", token, body)
    _check_status(status, resp)
    if not isinstance(resp, dict):
        # 通常 dict が返るが、サーバ実装が壊れた場合の保険。
        resp = {"success": False, "error": str(resp)}
    return (label, resp)


def _expand_scenario_glob(base_url: str, token: str | None, pattern: str) -> list[str]:
    """/api/v1/scenarios を引いて fnmatch で path をフィルタ。
    `*` は path 内の `/` も跨ぐ (Battle/* が Battle/Repro/X にもヒット)。"""
    import fnmatch
    status, body = _request("GET", f"{base_url}/api/v1/scenarios", token)
    _check_status(status, body)
    scenarios = body.get("scenarios", []) if isinstance(body, dict) else []
    matched: list[str] = []
    for s in scenarios:
        if not isinstance(s, dict):
            continue
        path = s.get("path", "")
        if path and fnmatch.fnmatchcase(path, pattern):
            matched.append(path)
    matched.sort()
    return matched


def _finalize_run(args, results: list[tuple[str, dict]], *, single: bool) -> None:
    """run 系コマンドの後処理 (出力 / レポート / exit code)。"""
    if args.json:
        if single:
            _emit_json(results[0][1])
        else:
            payload = {
                # label が glob 展開で確定したパスなので、resp に同名キーがあっても上書きされないよう
                # resp を先に展開して "path" を最後に書く (server 応答は ad-hoc 実行時に "path" が
                # null になるなど一致しない場合がある)。
                "scenarios": [{**resp, "path": label} for label, resp in results],
                "total": len(results),
                "passed": sum(1 for _, r in results if r.get("success")),
                "failed": sum(1 for _, r in results if not r.get("success")),
            }
            _emit_json(payload)
    else:
        if single:
            _emit_single_run_text(*results[0])
        else:
            _emit_glob_run_text(results)

    if args.report:
        try:
            _write_junit_report(args.report, results)
        except OSError as e:
            raise SystemExit(_red(f"JUnit report write error: {args.report}: {e}"))
        if not args.json:
            print(_dim(f"  JUnit report: {args.report}"))

    any_failed = any(not r.get("success") for _, r in results)
    sys.exit(2 if any_failed else 0)


def _emit_single_run_text(label: str, resp: dict) -> None:
    """単一シナリオの詳細表示 (既存挙動を保持)。"""
    ok = resp.get("success", False)
    head = _green("PASS") if ok else _red("FAIL")
    dur = resp.get("durationMs")
    print(f"{head}  {label}  ({dur} ms)")
    if not ok:
        idx = resp.get("failedAtStep", -1)
        print(f"  failedAtStep: {idx}")
    steps = resp.get("steps", []) or []
    for i, s in enumerate(steps):
        kind = s.get("kind", "?")
        s_ok = s.get("success", False)
        marker = _green("✓") if s_ok else _red("✗")
        s_dur = s.get("durationMs", 0)
        extra = ""
        if kind == "Command":
            extra = s.get("commandPath", "")
        elif kind in ("AssertEquals", "AssertNotEquals"):
            actual = s.get("actualValue")
            err = s.get("error")
            extra = f"actual={actual}"
            if err:
                extra += f"  {_red(err)}"
        print(f"  {marker} [{i}] {kind:<16} {extra} {_dim(f'({s_dur}ms)')}")


def _emit_glob_run_text(results: list[tuple[str, dict]]) -> None:
    """glob ヒット時の集計表示。1 行 per scenario + サマリ。"""
    width = min(max((len(label) for label, _ in results), default=0), 60)
    passed = failed = 0
    total_ms = 0.0
    for label, resp in results:
        ok = resp.get("success", False)
        dur = resp.get("durationMs", 0) or 0
        total_ms += dur
        marker = _green("✓") if ok else _red("✗")
        line = f"  {marker} {label.ljust(width)}  {_dim(f'({dur} ms)')}"
        if ok:
            passed += 1
            print(line)
        else:
            failed += 1
            idx = resp.get("failedAtStep", -1)
            print(f"{line}  failedAtStep={idx}")
            steps = resp.get("steps") or []
            if isinstance(idx, int) and 0 <= idx < len(steps):
                step = steps[idx]
                kind = step.get("kind", "?")
                err = step.get("error") or ""
                actual = step.get("actualValue")
                msg = err or f"{kind} actual={actual}"
                print(f"      {_red(msg)}")
    print()
    head = _green("PASS") if failed == 0 else _red("FAIL")
    print(f"{head}  {passed + failed} scenarios, {passed} passed, {failed} failed  ({total_ms:.1f} ms total)")


def _xml_escape(s: str) -> str:
    return (s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
              .replace("\"", "&quot;"))


def _write_junit_report(path: str, results: list[tuple[str, dict]]) -> None:
    """JUnit XML を path に書く。tests=N、failures=F、time は秒。"""
    failures = sum(1 for _, r in results if not r.get("success"))
    total_time = sum((r.get("durationMs", 0) or 0) for _, r in results) / 1000.0
    lines: list[str] = ['<?xml version="1.0" encoding="UTF-8"?>']
    lines.append(
        f'<testsuites name="liminal" tests="{len(results)}" '
        f'failures="{failures}" time="{total_time:.3f}">'
    )
    lines.append(
        f'  <testsuite name="liminal" tests="{len(results)}" '
        f'failures="{failures}" time="{total_time:.3f}">'
    )
    for label, resp in results:
        dur_s = (resp.get("durationMs", 0) or 0) / 1000.0
        ok = resp.get("success", False)
        name_attr = _xml_escape(label)
        if ok:
            lines.append(f'    <testcase name="{name_attr}" time="{dur_s:.3f}"/>')
            continue
        idx = resp.get("failedAtStep", -1)
        steps = resp.get("steps") or []
        msg_parts = [f"failedAtStep={idx}"]
        details: list[str] = []
        if isinstance(idx, int) and 0 <= idx < len(steps):
            step = steps[idx]
            kind = step.get("kind", "?")
            err = step.get("error") or ""
            actual = step.get("actualValue")
            expected = step.get("expected")
            msg_parts.append(kind)
            if err:
                msg_parts.append(err)
            details.append(f"step[{idx}] {kind}")
            if actual is not None:
                details.append(f"  actualValue: {actual}")
            if expected is not None:
                details.append(f"  expected: {expected}")
            if err:
                details.append(f"  error: {err}")
        elif resp.get("error"):
            details.append(str(resp.get("error")))
        message = _xml_escape(" — ".join(msg_parts))
        body_text = _xml_escape("\n".join(details))
        lines.append(f'    <testcase name="{name_attr}" time="{dur_s:.3f}">')
        lines.append(f'      <failure message="{message}">{body_text}</failure>')
        lines.append('    </testcase>')
    lines.append('  </testsuite>')
    lines.append('</testsuites>')
    Path(path).parent.mkdir(parents=True, exist_ok=True)
    Path(path).write_text("\n".join(lines) + "\n", encoding="utf-8")


# -- argparse -------------------------------------------------------------

def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="liminal",
        description="LiminalPalette HTTP API CLI",
    )
    p.add_argument("--base-url", help="ベース URL を直接指定 (例: http://127.0.0.1:7611)")
    p.add_argument("--port", type=int, help="ポート番号を指定 (省略時はキャッシュ→7610〜7615 自動探索)")
    p.add_argument("--project", help="ターゲット Unity プロジェクト (projectName または projectPath)。"
                                       "省略時は $LP_PROJECT または cwd から自動検出")
    p.add_argument("--mode", choices=("editor", "runtime"),
                   help="同一プロジェクトで Editor / Play Mode (= Runtime) listener を区別する")
    p.add_argument("--token", help="Bearer トークン (省略時は ~/.liminal-palette/token または $LP_TOKEN)")
    p.add_argument("--json", action="store_true", help="JSON のままパイプ可能な形で出力")

    sub = p.add_subparsers(dest="command", required=True)

    sub.add_parser("health", help="サーバーの生存確認 (認証不要)")
    sp_doc = sub.add_parser("doctor", help="環境診断: token / プロジェクト解決 / 生存ポート一覧 (認証不要)")
    sp_doc.add_argument("--prune-stale", action="store_true",
                        help="probe しても応答が無かった cache エントリを ports.json から削除する")

    sp = sub.add_parser("project", help="プロジェクト固有設定 (preferred port 等) を表示 / 編集 (認証不要)")
    project_sub = sp.add_subparsers(dest="project_command", required=True)
    project_sub.add_parser("show", help="cwd 配下の ProjectSettings/LiminalPalette.json を表示 (live probe 付き)")
    sp_set = project_sub.add_parser("set-port", help="ProjectSettings/LiminalPalette.json に preferred port を書く")
    sp_set.add_argument("port_value", type=int, metavar="PORT", help="ポート番号 (1-65535)")
    sp_set.add_argument("--runtime", action="store_true",
                        help="Play Mode / Player ビルド用 (runtimePort) にセット。省略時は Editor の port にセット")
    sp_unset = project_sub.add_parser("unset-port", help="port または runtimePort を削除")
    sp_unset.add_argument("--runtime", action="store_true",
                          help="runtimePort を削除。省略時は port を削除")

    sp = sub.add_parser("commands", help="登録コマンドの一覧")
    sp.add_argument("--filter", help="path のプレフィックスで絞り込み (例: Player/)")

    sp = sub.add_parser("exec", help="コマンド実行")
    sp.add_argument("path", help="コマンドパス (例: Player/Health/Set)")
    sp.add_argument("kvargs", nargs="*", help="key=value 形式の引数")

    sp = sub.add_parser("logs", help="実行履歴")
    sp.add_argument("--limit", type=int, default=20, help="取得件数 (既定 20、上限 200)")

    sp = sub.add_parser("state", help="LiminalObservableField のスナップショット")
    sp.add_argument("path", nargs="?", help="単一フィールドの path。省略で全件")

    sub.add_parser("scenarios", help="登録シナリオの一覧")

    sp = sub.add_parser("run", help="シナリオ実行 (named / glob / ad-hoc)")
    sp.add_argument("path", nargs="?", help="シナリオパス (例: Combat/EnemyTakesDamage)。glob (例: 'Battle/*') で複数実行も可。--steps 使用時は省略")
    sp.add_argument("--steps", metavar="FILE_OR_DASH", help="ad-hoc: '-' で stdin、それ以外はファイルから JSON を読む")
    sp.add_argument("--report", metavar="PATH", help="JUnit XML レポートを PATH に書き出す (CI で testsuite として読める)")

    return p


def main() -> None:
    parser = build_parser()
    args = parser.parse_args()

    # doctor / project はサーバー無しでもローカルファイルだけで動くので discovery / 認証を通さない。
    if args.command == "doctor":
        cmd_doctor(args)
        return
    if args.command == "project":
        cmd_project(args)
        return

    token = _read_token(args.token)
    # health 以外は認証必須なのでトークンが無ければ早期終了。
    needs_auth = args.command not in ("health",)
    if needs_auth and not token:
        raise SystemExit(_red(
            f"トークンが見つかりません。{DEFAULT_TOKEN_PATH} を作成するか、"
            "--token か $LP_TOKEN で指定してください。"
        ))

    base_url, _info = _discover_base_url(args.base_url, args.port, args.project, args.mode)

    handlers = {
        "health": cmd_health,
        "commands": cmd_commands,
        "exec": cmd_exec,
        "logs": cmd_logs,
        "state": cmd_state,
        "scenarios": cmd_scenarios,
        "run": cmd_run,
    }
    handler = handlers[args.command]
    try:
        handler(args, base_url, token)
    except ApiError as e:
        raise SystemExit(_red(str(e)))


if __name__ == "__main__":
    main()
