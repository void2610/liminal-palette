#!/usr/bin/env python3
# LiminalPalette HTTP API を叩くシングルファイル CLI。
# 依存は Python 3 標準ライブラリのみ。chmod +x で動かす想定。
#
# 使い方:
#   liminal health
#   liminal doctor [--prune-stale]
#   liminal commands [--filter Player/]
#   liminal exec Player/Health/Set value=100
#   liminal logs --limit 10
#   liminal state [Player/Health]
#   liminal scenarios
#   liminal run Combat/EnemyTakesDamage
#   liminal project show
#   liminal project set-port [--runtime] 7613
#   liminal project unset-port [--runtime]
#
# トークンは ~/.liminal-palette/token を自動で読む。
# ポート発見:
#   1. cwd / --project から ProjectSettings/LiminalPalette.json の preferred port を読み、最優先で probe
#   2. ~/.liminal-palette/ports.json のキャッシュを次に試す
#   3. それでもダメなら 7610〜7615 を short timeout で probe
# 同一プロジェクトの Editor / Play Mode は /health の mode で区別。--mode editor|runtime で絞れる。
# 複数 Unity プロジェクト同時起動時は --project または cwd 検出でターゲットを決める
# (/health の projectName / projectPath で照合)。

import argparse
import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

# -- 設定 -----------------------------------------------------------------

DEFAULT_PORTS = [7610, 7611, 7612, 7613, 7614, 7615]
DEFAULT_TOKEN_PATH = Path.home() / ".liminal-palette" / "token"
DEFAULT_CACHE_PATH = Path.home() / ".liminal-palette" / "ports.json"
TIMEOUT_SEC = 10
PROBE_TIMEOUT_SEC = 0.4  # discovery 中の /health probe 用 (本リクエストとは別)

# -- 端末カラー (TTY のみ) ------------------------------------------------

_USE_COLOR = sys.stdout.isatty() and os.environ.get("NO_COLOR") is None


def _c(code: str, s: str) -> str:
    return f"\033[{code}m{s}\033[0m" if _USE_COLOR else s


def _green(s): return _c("32", s)
def _red(s): return _c("31", s)
def _yellow(s): return _c("33", s)
def _cyan(s): return _c("36", s)
def _dim(s): return _c("2", s)
def _bold(s): return _c("1", s)


# -- HTTP -----------------------------------------------------------------

class ApiError(Exception):
    def __init__(self, status: int, body: str, url: str):
        self.status = status
        self.body = body
        self.url = url
        super().__init__(f"HTTP {status} {url}: {body}")


def _request(method: str, url: str, token: str | None, body: dict | None = None) -> tuple[int, dict | str]:
    data = None
    headers = {"Accept": "application/json"}
    if token:
        headers["Authorization"] = f"Bearer {token}"
    if body is not None:
        data = json.dumps(body).encode("utf-8")
        headers["Content-Type"] = "application/json"

    req = urllib.request.Request(url, data=data, method=method, headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=TIMEOUT_SEC) as resp:
            raw = resp.read().decode("utf-8")
            return resp.status, _try_json(raw)
    except urllib.error.HTTPError as e:
        raw = e.read().decode("utf-8", errors="replace")
        return e.code, _try_json(raw)
    except urllib.error.URLError as e:
        raise ApiError(0, str(e.reason), url) from e


def _try_json(raw: str):
    if not raw:
        return ""
    try:
        return json.loads(raw)
    except json.JSONDecodeError:
        return raw


# -- ベース URL とトークンの解決 ------------------------------------------

def _read_token(explicit: str | None) -> str | None:
    if explicit:
        return explicit
    env = os.environ.get("LP_TOKEN")
    if env:
        return env.strip()
    if DEFAULT_TOKEN_PATH.is_file():
        return DEFAULT_TOKEN_PATH.read_text(encoding="utf-8").strip()
    return None


def _probe_port(port: int, timeout: float = PROBE_TIMEOUT_SEC) -> dict | None:
    """/health を short timeout で叩いて dict を返す。失敗は None。例外は出さない。"""
    url = f"http://127.0.0.1:{port}/api/v1/health"
    req = urllib.request.Request(url, method="GET", headers={"Accept": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            if resp.status != 200:
                return None
            data = json.loads(resp.read().decode("utf-8"))
            return data if isinstance(data, dict) else None
    except (urllib.error.URLError, json.JSONDecodeError, ValueError, OSError):
        return None


def _probe_url(base_url: str, timeout: float = 2.0) -> dict | None:
    """--base-url 指定時に /health を引いて info を取る (失敗は致命でない)。"""
    url = base_url.rstrip("/") + "/api/v1/health"
    req = urllib.request.Request(url, method="GET", headers={"Accept": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            if resp.status != 200:
                return None
            data = json.loads(resp.read().decode("utf-8"))
            return data if isinstance(data, dict) else None
    except (urllib.error.URLError, json.JSONDecodeError, ValueError, OSError):
        return None


# -- ポートキャッシュ -----------------------------------------------------
#
# ~/.liminal-palette/ports.json (v2):
#   {
#     "version": 2,
#     "projects": {
#       "<projectPath>": {
#         "projectName": "...",
#         "ports": {"editor": 7610, "runtime": 7611}
#       }
#     }
#   }
#
# キーは projectPath (絶対パス)。ports は mode ("editor"|"runtime") ごとに別々のポートを持つ。
# 旧 v1 キャッシュはサイレントに破棄される (再構築されるだけ)。

CACHE_VERSION = 2
KNOWN_MODES = ("editor", "runtime")


def _empty_cache() -> dict:
    return {"version": CACHE_VERSION, "projects": {}}


def _load_cache() -> dict:
    if not DEFAULT_CACHE_PATH.is_file():
        return _empty_cache()
    try:
        data = json.loads(DEFAULT_CACHE_PATH.read_text(encoding="utf-8"))
        if not isinstance(data, dict) or data.get("version") != CACHE_VERSION:
            return _empty_cache()
        if not isinstance(data.get("projects"), dict):
            data["projects"] = {}
        return data
    except (json.JSONDecodeError, OSError):
        return _empty_cache()


def _save_cache(cache: dict) -> None:
    try:
        DEFAULT_CACHE_PATH.parent.mkdir(parents=True, exist_ok=True)
        DEFAULT_CACHE_PATH.write_text(
            json.dumps(cache, ensure_ascii=False, indent=2), encoding="utf-8"
        )
    except OSError:
        pass  # cache はベストエフォート


def _record_cache(cache: dict, info: dict, port: int) -> None:
    """alive な /health 結果を cache に書き戻す。mode が読み取れない応答 (古い server) は 'editor' とみなす。"""
    path = info.get("projectPath") or ""
    if not path:
        return
    mode = info.get("mode") if info.get("mode") in KNOWN_MODES else "editor"
    projects = cache.setdefault("projects", {})
    entry = projects.get(path)
    if not isinstance(entry, dict):
        entry = {"projectName": "", "ports": {}}
        projects[path] = entry
    entry["projectName"] = info.get("projectName") or entry.get("projectName") or ""
    ports = entry.get("ports")
    if not isinstance(ports, dict):
        ports = {}
        entry["ports"] = ports
    if isinstance(port, int):
        ports[mode] = port


def _cache_iter_entries(cache: dict):
    """cache 内の (projectPath, projectName, mode, port) を順に yield する (壊れた entry は無視)。"""
    projects = cache.get("projects", {})
    if not isinstance(projects, dict):
        return
    for path, entry in projects.items():
        if not isinstance(entry, dict):
            continue
        name = entry.get("projectName") if isinstance(entry.get("projectName"), str) else ""
        ports = entry.get("ports") if isinstance(entry.get("ports"), dict) else {}
        for mode, port in ports.items():
            if mode in KNOWN_MODES and isinstance(port, int):
                yield (str(path), name, mode, port)


# -- プロジェクト解決 -----------------------------------------------------

def _detect_project_from_cwd() -> str | None:
    """cwd から ProjectSettings/ProjectVersion.txt を持つ親ディレクトリを探す。Unity プロジェクトの目印。"""
    try:
        p = Path.cwd().resolve()
    except OSError:
        return None
    for d in [p, *p.parents]:
        if (d / "ProjectSettings" / "ProjectVersion.txt").is_file():
            return str(d)
    return None


def _resolve_target(explicit: str | None) -> tuple[str | None, str | None]:
    """target identity と (分かれば) その絶対 projectPath を返す。
    優先順位: --project > $LP_PROJECT > cwd 検出。
    --project が path として存在しない or 単なる名前の場合は projectPath は None を返す。
    """
    raw = explicit or os.environ.get("LP_PROJECT")
    if raw:
        try:
            cand = Path(raw)
            if cand.exists() and cand.is_dir():
                p = str(cand.resolve())
                return (p, p)
        except OSError:
            pass
        # path として解決できない → 名前として扱う (projectName マッチ用)
        return (raw, None)
    cwd_path = _detect_project_from_cwd()
    if cwd_path:
        return (cwd_path, cwd_path)
    return (None, None)


def _read_preferred_ports(project_path: str | None) -> dict:
    """<project_path>/ProjectSettings/LiminalPalette.json から preferred port を読む。
    戻り値: {'editor': int|None, 'runtime': int|None}。
    'editor' は port フィールド (Editor が使う / Runtime のフォールバックでも使える)。
    'runtime' は runtimePort フィールド (Play Mode / Player ビルド専用)。
    """
    out = {"editor": None, "runtime": None}
    if not project_path:
        return out
    cfg = _project_config_path(project_path)
    if not cfg.is_file():
        return out
    try:
        data = json.loads(cfg.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError):
        return out
    if not isinstance(data, dict):
        return out
    def _valid(v):
        return v if isinstance(v, int) and 1 <= v <= 65535 else None
    out["editor"] = _valid(data.get("port"))
    out["runtime"] = _valid(data.get("runtimePort"))
    return out


def _project_config_path(project_path: str) -> Path:
    return Path(project_path) / "ProjectSettings" / "LiminalPalette.json"


def _matches_project(info: dict, target: str | None) -> bool:
    """info の projectPath / projectName が target に一致するか。target=None なら無条件 True。"""
    if target is None:
        return True
    if info.get("projectPath") == target:
        return True
    if info.get("projectName") == target:
        return True
    try:
        t = str(Path(target).resolve())
        if info.get("projectPath") == t:
            return True
    except OSError:
        pass
    return False


def _matches_mode(info: dict, mode: str | None) -> bool:
    """mode フィルタ。--mode 未指定なら無条件 True。古い server 応答 (mode フィールド無し) は editor とみなす。"""
    if mode is None:
        return True
    actual = info.get("mode") if info.get("mode") in KNOWN_MODES else "editor"
    return actual == mode


def _format_alive(alive: list[tuple[int, dict]]) -> str:
    return "\n".join(
        f"  - port {p}: [{i.get('mode','?')}] {i.get('projectName','?')}  ({i.get('projectPath','?')})"
        for p, i in alive
    )


def _find_cached_ports(cache: dict, target: str | None, target_path: str | None,
                      mode: str | None) -> list[int]:
    """cache から target + mode に合致するポートを返す。複数 mode 候補がある場合は editor → runtime 順。"""
    out: list[int] = []
    modes_wanted = [mode] if mode in KNOWN_MODES else list(KNOWN_MODES)
    projects = cache.get("projects", {})
    # target_path 一致 (一番強い)
    candidate_paths: list[str] = []
    if target_path and target_path in projects:
        candidate_paths.append(target_path)
    # 名前一致
    if target and not target_path:
        for path, entry in projects.items():
            if isinstance(entry, dict) and entry.get("projectName") == target:
                candidate_paths.append(str(path))
    for path in candidate_paths:
        entry = projects.get(path)
        if not isinstance(entry, dict):
            continue
        ports = entry.get("ports") if isinstance(entry.get("ports"), dict) else {}
        for m in modes_wanted:
            p = ports.get(m)
            if isinstance(p, int) and p not in out:
                out.append(p)
    return out


def _build_candidate_ports(port: int | None, preferred: dict, mode: str | None,
                           cache: dict | None = None) -> list[int]:
    """probe するポート順序を決める。
    --port 明示 → 1 個だけ。
    そうでなければ:
      preferred (mode 別シード) と隣接 5 個 → cache 既知ポート (mode フィルタ済) → DEFAULT_PORTS。
    cache を混ぜることで target 未指定 (cwd 検出失敗時等) でも過去成功ポートを優先できる。
    """
    if port is not None:
        return [port]
    seeds: list[int] = []
    if mode == "editor":
        if preferred.get("editor") is not None:
            seeds.append(preferred["editor"])
    elif mode == "runtime":
        if preferred.get("runtime") is not None:
            seeds.append(preferred["runtime"])
        if preferred.get("editor") is not None:
            seeds.append(preferred["editor"])
    else:
        if preferred.get("editor") is not None:
            seeds.append(preferred["editor"])
        if preferred.get("runtime") is not None:
            seeds.append(preferred["runtime"])
    out: list[int] = []
    for seed in seeds:
        for p in range(seed, seed + 6):
            if 1 <= p <= 65535 and p not in out:
                out.append(p)
    if cache is not None:
        modes_wanted = (mode,) if mode in KNOWN_MODES else KNOWN_MODES
        for _, _, m, p in _cache_iter_entries(cache):
            if m in modes_wanted and p not in out:
                out.append(p)
    for p in DEFAULT_PORTS:
        if p not in out:
            out.append(p)
    return out


def _discover_base_url(
    explicit: str | None, port: int | None, project: str | None, mode: str | None
) -> tuple[str, dict]:
    """(base_url, /health の dict) を返す。/health 失敗時は dict が空。"""
    # 明示の --base-url が最優先。/health は best-effort で取る。
    if explicit:
        info = _probe_url(explicit) or {}
        return explicit.rstrip("/"), info

    target, target_path = _resolve_target(project)
    preferred = _read_preferred_ports(target_path)
    cache = _load_cache()
    candidate_ports = _build_candidate_ports(port, preferred, mode, cache)

    # 1) ターゲット指定 + キャッシュヒット時はそのポートを最優先で試す。
    #    mode 指定時は同じ mode の cache のみ使う。
    if target and port is None:
        for cached_port in _find_cached_ports(cache, target, target_path, mode):
            info = _probe_port(cached_port)
            if info and _matches_project(info, target) and _matches_mode(info, mode):
                _record_cache(cache, info, cached_port)
                _save_cache(cache)
                return f"http://127.0.0.1:{cached_port}", info

    # 2) 候補全部 probe (短いタイムアウト)。
    alive: list[tuple[int, dict]] = []
    for p in candidate_ports:
        info = _probe_port(p)
        if info:
            alive.append((p, info))
            _record_cache(cache, info, p)
    _save_cache(cache)

    if not alive:
        msg = (
            "Liminal Palette サーバーが見つかりません (試したポート: "
            + ",".join(str(p) for p in candidate_ports)
            + ")"
        )
        raise SystemExit(_red(msg))

    # 3) target / mode フィルタを順に適用。
    matching = [
        (p, i) for p, i in alive
        if _matches_project(i, target) and _matches_mode(i, mode)
    ]
    if target and not matching:
        raise SystemExit(_red(
            f"指定のプロジェクト '{target}'"
            + (f" / mode={mode}" if mode else "")
            + " に一致する Unity サーバーが見つかりません。\n"
            f"生存中:\n{_format_alive(alive)}"
        ))
    if mode and not matching:
        raise SystemExit(_red(
            f"mode={mode} の Unity サーバーが生存していません。\n生存中:\n{_format_alive(alive)}"
        ))
    if not matching:
        # target も mode も指定なし、かつ複数生存
        if len(alive) == 1:
            p, info = alive[0]
            return f"http://127.0.0.1:{p}", info
        raise SystemExit(_red(
            "複数の Unity プロジェクトが起動中です。--project / --mode "
            "(または cwd を Unity プロジェクト配下にして) ターゲットを指定してください:\n"
            + _format_alive(alive)
        ))

    if len(matching) > 1:
        # 一致内容を見て適切なヒントを出す:
        # - 同一 projectPath で mode だけ違う → --mode
        # - 別プロジェクト同士 → --project
        # - それ以外 (同一 project + 同一 mode で複数 port = 異常) → --port
        paths = {i.get("projectPath") for _, i in matching if i.get("projectPath")}
        modes = {i.get("mode") for _, i in matching if i.get("mode")}
        if len(paths) <= 1 and len(modes) > 1:
            hint = "--mode editor|runtime"
        elif len(paths) > 1:
            hint = "--project (または --mode)"
        else:
            hint = "--port"
        raise SystemExit(_red(
            f"複数のサーバーが一致しました。{hint} で 1 つに絞ってください:\n"
            f"{_format_alive(matching)}"
        ))

    p, info = matching[0]
    return f"http://127.0.0.1:{p}", info


# -- 出力ヘルパ -----------------------------------------------------------

def _emit_json(obj):
    print(json.dumps(obj, ensure_ascii=False, indent=2))


def _check_status(status: int, body) -> None:
    if 200 <= status < 300:
        return
    if isinstance(body, dict) and "error" in body:
        msg = body["error"]
    else:
        msg = str(body)
    raise SystemExit(_red(f"HTTP {status}: {msg}"))


# -- サブコマンド ---------------------------------------------------------

def cmd_health(args, base_url, _token):
    status, body = _request("GET", f"{base_url}/api/v1/health", token=None)
    _check_status(status, body)
    if args.json:
        _emit_json(body)
        return
    print(f"{_green('ok')}  {base_url}")
    print(f"  version       : {body.get('version')}")
    print(f"  mode          : {body.get('mode') or _dim('(unknown)')}")
    print(f"  projectName   : {body.get('projectName') or _dim('(unknown)')}")
    print(f"  projectPath   : {body.get('projectPath') or _dim('(unknown)')}")
    print(f"  commandCount  : {body.get('commandCount')}")


def cmd_doctor(args):
    """環境診断: token / cwd / cache / 生存ポート / 解決結果 を一覧表示。"""
    # 1) Token — _read_token と同じ判定 (strip 後に空なら「未取得」扱い) で表示する。
    print(_bold("Token:"))
    env_token_raw = os.environ.get("LP_TOKEN")
    env_token_stripped = env_token_raw.strip() if env_token_raw else ""
    token_displayed = False
    if env_token_stripped:
        print(f"  {_green('found')}  via $LP_TOKEN ({len(env_token_stripped)} chars)")
        token_displayed = True
    elif env_token_raw:
        # 設定はされているが strip すると空 → _read_token は "" を返し auth に失敗する。
        print(f"  {_yellow('empty')}  $LP_TOKEN は空白のみ。実質未設定として扱われます")
        token_displayed = True
    if not token_displayed:
        if DEFAULT_TOKEN_PATH.is_file():
            try:
                t = DEFAULT_TOKEN_PATH.read_text(encoding="utf-8").strip()
                if t:
                    print(f"  {_green('found')}  {DEFAULT_TOKEN_PATH}  ({len(t)} chars)")
                else:
                    print(f"  {_yellow('empty')}  {DEFAULT_TOKEN_PATH} は空。Unity Editor を起動して再生成してください")
            except OSError as e:
                print(f"  {_red('error')}  {DEFAULT_TOKEN_PATH}: {e}")
        else:
            print(f"  {_red('NOT FOUND')}  expected at {DEFAULT_TOKEN_PATH}")
            print(_dim(f"    Unity Editor を一度起動するか、{DEFAULT_TOKEN_PATH} を作ってください"))

    # 2) cwd / project detection (cwd が削除済み等で取れないこともあるので握る)
    print(_bold("\nProject detection:"))
    try:
        cwd_disp = str(Path.cwd())
    except OSError as e:
        cwd_disp = _red(f"(unavailable: {e})")
    print(f"  cwd            : {cwd_disp}")
    detected = _detect_project_from_cwd()
    if detected:
        print(f"  cwd→project    : {_green(detected)}")
    else:
        print(f"  cwd→project    : {_dim('(no Unity project marker found above cwd)')}")
    if args.project:
        print(f"  --project      : {args.project}")
    env_proj = os.environ.get("LP_PROJECT")
    if env_proj:
        print(f"  $LP_PROJECT    : {env_proj}")
    target, target_path = _resolve_target(args.project)
    print(f"  resolved target: {target if target else _dim('(none)')}")
    if getattr(args, "mode", None):
        print(f"  --mode         : {args.mode}")
    preferred = _read_preferred_ports(target_path)
    if target_path:
        cfg_path = _project_config_path(target_path)
        if cfg_path.is_file():
            ed = preferred.get("editor")
            rt = preferred.get("runtime")
            print(f"  port (editor)  : {_cyan(str(ed)) if ed else _dim('(unset)')}")
            print(f"  runtimePort    : {_cyan(str(rt)) if rt else _dim('(unset, falls back to port)')}")
        else:
            print(f"  preferred port : {_dim('(no ' + str(cfg_path) + ' — falling back to defaults)')}")

    # 3) Cache v2 (手編集で壊れた entry でも落ちない / 同 project の editor/runtime 両方表示)
    cache = _load_cache()
    print(_bold("\nPort cache:"))
    print(f"  {DEFAULT_CACHE_PATH}")
    rows = list(_cache_iter_entries(cache))
    if not rows:
        print(_dim("  (empty)"))
    else:
        name_w = max((len(n) for _, n, _, _ in rows), default=8)
        for path, name, mode, port in rows:
            disp_name = name if name else "?"
            print(f"    port {port:>5}  [{mode:<7}] {disp_name.ljust(name_w)}  {_dim(path)}")

    # 4) Live probe — preferred のレンジ + cache 内の port + DEFAULT_PORTS をユニーク順序で probe。
    probe_ports = _build_candidate_ports(None, preferred, getattr(args, "mode", None), cache)
    for _, _, _, cport in rows:
        if cport not in probe_ports:
            probe_ports.append(cport)
    print(_bold(f"\nLive probe ({','.join(str(p) for p in probe_ports)}):"))
    alive: list[tuple[int, dict]] = []
    alive_ports: set[int] = set()
    for p in probe_ports:
        info = _probe_port(p)
        if info:
            alive.append((p, info))
            alive_ports.add(p)
            _record_cache(cache, info, p)
            name = info.get("projectName") or "(no name)"
            path = info.get("projectPath") or "(no path)"
            ver = info.get("version") or "?"
            cnt = info.get("commandCount", "?")
            mode = info.get("mode") or "?"
            print(f"  {_green('●')} {p}  [{mode:<7}] {name:<24} {_dim(f'v{ver} cmds={cnt}')}  {_dim(path)}")
        else:
            print(_dim(f"  ○ {p}  (no response)"))

    # 5) キャッシュ prune: 何度 probe しても応答が無い (= cache に残ってるが alive_ports に無い)
    #    エントリで、かつ probe 対象に含まれていたものは古い可能性が高い。明示的に prune するため
    #    --prune-stale 時のみ削除し、通常はマークだけ表示する。
    pruned = 0
    if getattr(args, "prune_stale", False):
        projects = cache.get("projects", {})
        for path, entry in list(projects.items()):
            if not isinstance(entry, dict):
                projects.pop(path, None)
                pruned += 1
                continue
            ports = entry.get("ports") if isinstance(entry.get("ports"), dict) else {}
            for mode, port in list(ports.items()):
                if isinstance(port, int) and port in probe_ports and port not in alive_ports:
                    ports.pop(mode, None)
                    pruned += 1
            if not ports:
                projects.pop(path, None)
    _save_cache(cache)

    # 6) Resolution
    print(_bold("\nResolution:"))
    if pruned:
        print(_dim(f"  pruned {pruned} stale cache entry/entries"))
    if not alive:
        print(_red("  no live server"))
        return
    matching = [
        (p, i) for p, i in alive
        if _matches_project(i, target) and _matches_mode(i, getattr(args, "mode", None))
    ]
    if target and not matching:
        print(_red(f"  no port matches target '{target}'"))
    elif not matching:
        if len(alive) == 1:
            p, info = alive[0]
            print(f"  {_green('selected')} → http://127.0.0.1:{p}  [{info.get('mode','?')}] ({info.get('projectName','?')})")
        else:
            print(_yellow("  ambiguous: multiple servers alive (specify --project / --mode)"))
            for p, info in alive:
                print(f"    - port {p}: [{info.get('mode','?')}] {info.get('projectName','?')}  {_dim(info.get('projectPath','?'))}")
    elif len(matching) == 1:
        p, info = matching[0]
        print(f"  {_green('selected')} → http://127.0.0.1:{p}  [{info.get('mode','?')}] ({info.get('projectName','?')})")
    else:
        print(_yellow("  ambiguous: multiple matches (use --mode editor|runtime)"))
        for p, info in matching:
            print(f"    - port {p}: [{info.get('mode','?')}] {info.get('projectName','?')}")


def cmd_project(args):
    """ProjectSettings/LiminalPalette.json を表示 / 編集する。"""
    sub = args.project_command
    if sub == "show":
        _project_show(args)
    elif sub == "set-port":
        _project_set_port(args)
    elif sub == "unset-port":
        _project_unset_port(args)
    else:
        raise SystemExit(_red(f"unknown subcommand: {sub}"))


def _require_cwd_project() -> str:
    project_path = _detect_project_from_cwd()
    if not project_path:
        raise SystemExit(_red(
            f"cwd ({Path.cwd()}) 配下に Unity プロジェクトが見つかりません。"
            "ProjectSettings/ProjectVersion.txt がある場所で実行してください。"
        ))
    return project_path


def _project_show(args):
    project_path = _require_cwd_project()
    cfg_path = _project_config_path(project_path)
    print(_bold("Project:"))
    print(f"  path  : {project_path}")
    print(f"  config: {cfg_path}")
    preferred = _read_preferred_ports(project_path)
    if not cfg_path.is_file():
        print(_dim(f"  (no {cfg_path.name} — IpcSettings.DefaultPort=7610 にフォールバック)"))
        print(_dim(f"  固定するなら: liminal project set-port 7613"))
    else:
        try:
            raw = cfg_path.read_text(encoding="utf-8")
        except OSError as e:
            raise SystemExit(_red(f"  read error: {e}"))
        ed = preferred.get("editor")
        rt = preferred.get("runtime")
        print(f"  port (editor)    : {_cyan(str(ed)) if ed else _dim('(unset)')}")
        print(f"  runtimePort      : {_cyan(str(rt)) if rt else _dim('(unset, falls back to port)')}")
        print(_dim("  raw              :"))
        for line in raw.rstrip("\n").splitlines():
            print(_dim(f"    {line}"))

    # ライブ probe: 設定ポート + 隣接 + DEFAULT_PORTS を叩いて、このプロジェクトの listener が
    # 現在どこに居るか / preferred 通りに立ち上がっているかを表示。
    probe_ports = _build_candidate_ports(None, preferred, None)
    print(_bold("\nLive listeners:"))
    found_any = False
    for p in probe_ports:
        info = _probe_port(p)
        if info and _matches_project(info, project_path):
            found_any = True
            mode = info.get("mode") or "?"
            ver = info.get("version") or "?"
            cnt = info.get("commandCount", "?")
            tag = ""
            ed = preferred.get("editor")
            rt = preferred.get("runtime")
            if mode == "editor" and ed == p:
                tag = _dim(" (matches port)")
            elif mode == "runtime" and rt == p:
                tag = _dim(" (matches runtimePort)")
            elif mode == "runtime" and rt is None and ed == p:
                tag = _dim(" (matches port, runtimePort unset)")
            print(f"  {_green('●')} {p}  [{mode}]{tag} {_dim(f'v{ver} cmds={cnt}')}")
    if not found_any:
        print(_dim("  (no listener for this project — Unity Editor not running?)"))


def _project_set_port(args):
    project_path = _require_cwd_project()
    port = args.port_value
    if not (1 <= port <= 65535):
        raise SystemExit(_red(f"port は 1..65535 の範囲で指定してください: {port}"))
    field = "runtimePort" if getattr(args, "runtime", False) else "port"
    cfg_path = _project_config_path(project_path)
    data: dict = {}
    if cfg_path.is_file():
        try:
            existing_raw = cfg_path.read_text(encoding="utf-8")
        except OSError as e:
            raise SystemExit(_red(f"read error: {cfg_path}: {e}"))
        try:
            existing = json.loads(existing_raw)
            if isinstance(existing, dict):
                data = existing
        except json.JSONDecodeError:
            print(_yellow(f"warning: {cfg_path} の JSON パースに失敗。上書きします。"))
    data[field] = port
    cfg_path.parent.mkdir(parents=True, exist_ok=True)
    try:
        cfg_path.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    except OSError as e:
        raise SystemExit(_red(f"write error: {cfg_path}: {e}"))
    print(f"{_green('wrote')}  {cfg_path}")
    print(f"  {field} = {port}")
    if field == "port":
        print(_dim("  Unity Editor 再起動 (もしくは DomainReload) で反映されます"))
    else:
        print(_dim("  Play Mode を入り直すと反映されます"))


def _project_unset_port(args):
    project_path = _require_cwd_project()
    cfg_path = _project_config_path(project_path)
    if not cfg_path.is_file():
        print(_dim(f"  (no {cfg_path.name} — 何もしません)"))
        return
    field = "runtimePort" if getattr(args, "runtime", False) else "port"
    try:
        raw = cfg_path.read_text(encoding="utf-8")
    except OSError as e:
        raise SystemExit(_red(f"read error: {cfg_path}: {e}"))
    try:
        data = json.loads(raw)
    except json.JSONDecodeError as e:
        raise SystemExit(_red(f"parse error: {e}"))
    if not isinstance(data, dict) or field not in data:
        print(_dim(f"  {field} は元々設定されていません"))
        return
    data.pop(field, None)
    try:
        if not data:
            # 全フィールド消えたらファイルごと削除 (空ファイルを残さない)
            cfg_path.unlink()
            print(f"{_green('removed')}  {cfg_path} (全フィールド消えたためファイルごと削除)")
        else:
            cfg_path.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
            print(f"{_green('updated')}  {cfg_path}")
            print(f"  {field} を削除")
    except OSError as e:
        raise SystemExit(_red(f"write error: {cfg_path}: {e}"))


def cmd_commands(args, base_url, token):
